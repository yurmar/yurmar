{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,
    "baseUrl": ".",

    "paths": {
      "@/*": ["resources/js/*"]
    },

    "types": ["vite/client"]
  },
  "include": [
    "resources/js/**/*"
  ]
}